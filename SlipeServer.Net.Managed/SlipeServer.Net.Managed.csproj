<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Platforms>AnyCPU;x64;x86;ARM64;ARM32</Platforms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>SlipeServer.Net.Managed</RootNamespace>
		<AssemblyName>SlipeServer.Net.Managed</AssemblyName>

		<IsPackable>true</IsPackable>
		<Authors>Slipe</Authors>
		<Company></Company>
		<Product>Slipe Server</Product>
		<PackageProjectUrl>https://github.com/mta-slipe/Slipe-server</PackageProjectUrl>
		<PackageIcon>slipe-logo.png</PackageIcon>
		<RepositoryUrl>https://github.com/mta-slipe/Slipe-server</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<Description>A managed C# implementation of the MTA San Andreas net layer for Slipe Server, with no native dependency.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SlipeServer.Net.Core\SlipeServer.Net.Core.csproj" />
		<ProjectReference Include="..\SlipeServer.Packets\SlipeServer.Packets.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The test suite drives internal receive-path state (InboundOrdering, MtaNetSession) directly. -->
		<InternalsVisibleTo Include="SlipeServer.Net.Managed.Tests" />
		<!-- Wire-capture tests that stay in mta-slipe/netdll-decompile need the same access. -->
		<InternalsVisibleTo Include="MtaNet.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\slipe-logo.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

</Project>
